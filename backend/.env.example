# Application Settings
LOG_LEVEL=INFO

# AI Integration
AI_MODE=mock
IBM_API_KEY=your_ibm_api_key_here
IBM_PROJECT_ID=your_ibm_project_id_here
IBM_URL=https://us-south.ml.cloud.ibm.com

# Database
DATABASE_URL=postgresql://scamshield:scamshield_pass@localhost:5432/scamshield_db

# Security
JWT_SECRET=supersecretkey_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=1440

# Threat Intelligence APIs
VIRUSTOTAL_API_KEY=your_virustotal_api_key
GOOGLE_SAFE_BROWSING_KEY=your_google_safe_browsing_key
PHISHTANK_API=your_phishtank_api_key
WHOIS_PROVIDER=your_whois_provider_url

# File Storage
REPORT_DIRECTORY=reports
